# Development defaults work without an .env.local file.
# Override these before sharing the app with your team.
ADMIN_NAME=admin
ADMIN_PASSWORD=local-santa-admin

# Vercel / Supabase: copy the transaction pooler URI from Supabase Connect.
# Keep this server-only; never use NEXT_PUBLIC_DATABASE_URL.
# URL-encode special characters in the database password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# If the server certificate chain is not trusted, download the CA certificate
# from Supabase > Database > Settings > SSL Configuration > Download Certificate.
# Set DATABASE_SSL_CA to its complete PEM contents (multiline or literal \n).
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Local development fallback only; not used when DATABASE_URL is set.
DATABASE_PATH=data/santa.sqlite

# Public origin for generated reset links. Use your hosted HTTPS origin in production.
APP_URL=http://127.0.0.1:3000
