# Development defaults work without an .env.local file.
# Override these before sharing the app with your team.
ADMIN_NAME=admin
ADMIN_PASSWORD=local-santa-admin

# SQLite file, relative to the project root or an absolute path.
DATABASE_PATH=data/santa.sqlite

# Public origin for generated reset links. Use your hosted HTTPS origin in production.
APP_URL=http://127.0.0.1:3000
